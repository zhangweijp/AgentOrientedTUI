{
  "name": "@agentina/aotui-terminal",
  "version": "1.0.2",
  "description": "AOTUI Terminal Application - Multi-terminal command execution for LLM workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node ../../scripts/generate-aoapp.mjs .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@aotui/sdk": "0.8.0-srt.1",
    "preact": "^10.25.4",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@aotui/runtime": "7.0.0-srt.1",
    "@types/node": "^22.15.21",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@aotui/runtime": "7.0.0-srt.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "picomatch@4.0.3": "4.0.4"
  },
  "pnpm": {
    "overrides": {
      "@aotui/runtime": "link:../../runtime",
      "@aotui/sdk": "link:../../sdk",
      "picomatch@4.0.3": "4.0.4"
    }
  },
  "files": [
    "dist",
    "aoapp.json"
  ]
}
