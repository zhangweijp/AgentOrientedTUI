{
  "name": "@agentina/aotui-ide",
  "version": "0.1.2",
  "description": "AOTUI IDE app for agent-oriented code browsing, search, editing, and LSP-assisted analysis.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node scripts/build-native-lsp.mjs && node ./node_modules/@typescript/native/bin/tsc && node ../../scripts/generate-aoapp.mjs .",
    "watch": "node ./node_modules/@typescript/native/bin/tsc --watch",
    "test": "jest --passWithNoTests",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --passWithNoTests",
    "test:view-type-tools": "node tests/view-type-tools.mjs",
    "test:workspace-create-lifecycle": "node tests/workspace-create-session-lifecycle.mjs",
    "test:integration": "node tests/run-scoped-ide-integration.mjs",
    "test:run": "npm run build && npm run test:jest && npm run test:view-type-tools && npm run test:workspace-create-lifecycle && npm run test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "build:native-lsp": "node scripts/build-native-lsp.mjs",
    "typecheck:lsp": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.lsp.json",
    "test:native-lsp": "node tests/native-lsp.e2e.mjs"
  },
  "dependencies": {
    "@aotui/sdk": "0.8.0-srt.1",
    "glob": "^10.3.10",
    "preact": "^10.29.1",
    "typebox": "1.4.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-types": "^3.17.5"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.19.30",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@jest/globals": "29.7.0"
  },
  "overrides": {
    "brace-expansion@1.1.12": "1.1.13",
    "brace-expansion@2.0.2": "2.0.3",
    "handlebars": "^4.7.9",
    "happy-dom": "^20.8.9",
    "minimatch@3.1.2": "3.1.4",
    "minimatch@9.0.5": "9.0.7",
    "picomatch@2.3.1": "2.3.2",
    "preact": "^10.29.1"
  },
  "optionalDependencies": {
    "pyright": "^1.1.390"
  },
  "pnpm": {
    "overrides": {
      "@aotui/sdk": "link:../../sdk",
      "brace-expansion@1.1.12": "1.1.13",
      "brace-expansion@2.0.2": "2.0.3",
      "handlebars": "^4.7.9",
      "happy-dom": "^20.8.9",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.7",
      "picomatch@2.3.1": "2.3.2",
      "preact": "^10.29.1"
    }
  },
  "keywords": [
    "aotui",
    "agent",
    "tui",
    "ide",
    "lsp"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "./native-lsp/tsgo"
    ]
  },
  "files": [
    "dist",
    "examples",
    "aoapp.json",
    "README.md",
    "LSP_SETUP.md",
    "SCOPED_IDE.md",
    "native-lsp",
    "toolchain",
    "scripts/build-native-lsp.mjs"
  ]
}
