diff --git a/experiments/semantic-kernel/src/adapters.ts b/experiments/semantic-kernel/src/adapters.ts
new file mode 100644
index 0000000..027d0b3
--- /dev/null
+++ b/experiments/semantic-kernel/src/adapters.ts
@@ -0,0 +1,55 @@
+import { tool, type ToolSet } from 'ai';
+import { McpServer, type CallToolResult } from '@modelcontextprotocol/server';
+import { z } from 'zod';
+import type { ActionResult, Observation, Session } from './contracts.js';
+
+/** One generic tool for this experiment; per-action input schemas remain in the observation. */
+export function createAiSdkTools(session: Session, observation: Observation): ToolSet {
+  if (observation.sessionId !== session.id) throw new Error('Observation belongs to a different session.');
+  const bindingIds = observation.views.flatMap(view =>
+    view.items.flatMap(item => item.actions.map(action => action.bindingId)));
+  if (!bindingIds.length) return {};
+  return {
+    aotui_execute: tool({
+      description: 'Execute a binding from the supplied observation. Input must match that binding\'s inputSchema.',
+      inputSchema: z.strictObject({ actionBindingId: z.enum(bindingIds), input: z.json() }),
+      execute: ({ actionBindingId, input }, { toolCallId, abortSignal }) => session.execute({
+        observationId: observation.id,
+        actionBindingId,
+        invocationId: toolCallId,
+        input,
+      }, abortSignal ? { signal: abortSignal } : undefined),
+    }),
+  };
+}
+
+function toMcpResult(value: Observation | ActionResult): CallToolResult {
+  const structuredContent = z.json().parse(value);
+  return {
+    content: [{ type: 'text', text: JSON.stringify(structuredContent) }],
+    structuredContent,
+    isError: 'status' in value && ['rejected', 'failed', 'unknown'].includes(value.status),
+  };
+}
+
+/** A server instance is bound to one session; callers cannot select another session. */
+export function createAotuiMcpServer(session: Session): McpServer {
+  const server = new McpServer({ name: 'aotui-semantic-kernel', version: '0.0.0' });
+  server.registerTool('aotui_observe', {
+    description: 'Read the current immutable observation and its available action bindings.',
+    inputSchema: z.strictObject({}),
+  }, () => toMcpResult(session.observe()));
+  server.registerTool('aotui_execute', {
+    description: 'Execute against the original observation; preserve rejected, accepted, and unknown outcomes.',
+    inputSchema: z.strictObject({
+      observationId: z.string().min(1),
+      actionBindingId: z.string().min(1),
+      invocationId: z.string().min(1),
+      input: z.json(),
+    }),
+  }, async (invocation, context) => toMcpResult(await session.execute(
+    invocation,
+    context.mcpReq.signal ? { signal: context.mcpReq.signal } : undefined,
+  )));
+  return server;
+}
diff --git a/experiments/semantic-kernel/src/contracts.ts b/experiments/semantic-kernel/src/contracts.ts
new file mode 100644
index 0000000..fba98c6
--- /dev/null
+++ b/experiments/semantic-kernel/src/contracts.ts
@@ -0,0 +1,113 @@
+import type { StandardJSONSchemaV1, StandardSchemaV1 } from '@standard-schema/spec';
+
+export type JsonValue = null | boolean | number | string | readonly JsonValue[] | JsonObject;
+export interface JsonObject { readonly [key: string]: JsonValue }
+
+export interface Target {
+  readonly kind: string;
+  readonly id: string;
+  readonly revision: string;
+  readonly data: JsonObject;
+}
+
+export type ActionResult =
+  | { readonly status: 'succeeded'; readonly value: JsonValue }
+  | { readonly status: 'rejected'; readonly code: string; readonly message: string }
+  | { readonly status: 'failed'; readonly code: string; readonly message: string; readonly effects: 'none' | 'partial' }
+  | { readonly status: 'accepted'; readonly operationId: string }
+  | { readonly status: 'unknown'; readonly code: string; readonly message: string };
+
+export interface ActionContext {
+  readonly target: Target;
+  readonly viewId: string;
+  readonly invocationId: string;
+  readonly signal: AbortSignal;
+}
+
+export type InputContract<I> = StandardSchemaV1<unknown, I> & StandardJSONSchemaV1<unknown, I>;
+
+export interface ActionSpec<I> {
+  readonly name: string;
+  readonly description: string;
+  readonly input: InputContract<I>;
+  readonly execute: (context: ActionContext, input: I) => ActionResult | Promise<ActionResult>;
+}
+
+/** Prepared once; the validator and executor are never serialized to a model. */
+export interface Action {
+  readonly name: string;
+  readonly description: string;
+  readonly inputSchema: JsonObject;
+  readonly validate: (input: unknown) => Promise<
+    { readonly valid: true; readonly value: unknown } |
+    { readonly valid: false; readonly message: string }
+  >;
+  readonly execute: (context: ActionContext, validated: unknown) => Promise<ActionResult>;
+}
+
+export interface ViewItem {
+  readonly label: string;
+  readonly target: Target;
+  readonly actions: readonly Action[];
+}
+
+export interface ViewSpec {
+  readonly id: string;
+  /** Synchronous projection from an already-read, coherent local resource cut. */
+  readonly project: () => readonly ViewItem[];
+  readonly subscribe?: (invalidate: () => void) => () => void;
+}
+
+export interface PublishedAction {
+  readonly bindingId: string;
+  readonly name: string;
+  readonly description: string;
+  readonly inputSchema: JsonObject;
+}
+
+export interface PublishedItem {
+  readonly label: string;
+  readonly refId: string;
+  readonly target: Target;
+  readonly actions: readonly PublishedAction[];
+}
+
+export interface Observation {
+  readonly id: string;
+  readonly sessionId: string;
+  readonly createdAt: number;
+  readonly expiresAt: number;
+  readonly views: readonly { readonly id: string; readonly items: readonly PublishedItem[] }[];
+}
+
+export interface Invocation {
+  readonly observationId: string;
+  readonly actionBindingId: string;
+  readonly invocationId: string;
+  readonly input: JsonValue;
+}
+
+export interface TraceEvent {
+  readonly sequence: number;
+  readonly type: string;
+  readonly data: JsonObject;
+}
+
+export interface SessionOptions {
+  readonly now?: () => number;
+  readonly ttlMs?: number;
+  readonly maxObservations?: number;
+  readonly maxInvocations?: number;
+  readonly maxTraceEvents?: number;
+}
+
+export interface Session {
+  readonly id: string;
+  openView(spec: ViewSpec): () => Promise<void>;
+  observe(): Observation;
+  execute(invocation: Invocation, options?: { readonly signal?: AbortSignal }): Promise<ActionResult>;
+  /** Revoke views and close runtime scopes; arbitrary external Promises may outlive cancellation. */
+  close(): Promise<void>;
+  /** activeCalls counts owned runtime scopes, not all external work still running. */
+  inspect(): { readonly activeCalls: number; readonly views: number; readonly observations: number; readonly invocations: number; readonly events: readonly TraceEvent[] };
+}
diff --git a/experiments/semantic-kernel/src/demo.ts b/experiments/semantic-kernel/src/demo.ts
new file mode 100644
index 0000000..47acf86
--- /dev/null
+++ b/experiments/semantic-kernel/src/demo.ts
@@ -0,0 +1,36 @@
+import { createSession } from './kernel.js';
+import { TaskRepository, openTaskView } from './task-app.js';
+
+const repository = new TaskRepository([
+  { id: 'task-a', title: '修复登录超时' },
+  { id: 'task-b', title: '补充 API 文档' },
+]);
+const session = createSession();
+openTaskView(session, repository, 'inbox');
+
+try {
+  const observation = session.observe();
+  const first = observation.views[0]!.items[0]!;
+  repository.reorder(['task-b', 'task-a']);
+  const command = {
+    observationId: observation.id,
+    actionBindingId: first.actions[0]!.bindingId,
+    invocationId: 'demo-complete-a',
+    input: {},
+  };
+  const completion = await session.execute(command);
+  const duplicate = await session.execute(command);
+  const next = session.observe();
+  const remaining = next.views[0]!.items.find(item => item.target.id === 'task-b')!;
+  repository.rename('task-b', '文档已被其他操作者修改');
+  const conflict = await session.execute({
+    observationId: next.id,
+    actionBindingId: remaining.actions[0]!.bindingId,
+    invocationId: 'demo-stale-b',
+    input: {},
+  });
+  console.log(JSON.stringify({ completion, duplicate, conflict, actualTasks: repository.list(), writes: repository.writes }, null, 2));
+} finally {
+  await session.close();
+  console.log(JSON.stringify({ afterClose: session.inspect().activeCalls, subscriptions: repository.listenerCount }));
+}
