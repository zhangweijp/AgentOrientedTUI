- NEXT_WAVE_RECOMMENDATION.md：下阶段最小路径及未满足门槛，不替 ChatGPT 直接批准。

最后 Codex 答复按六块组织：实际代码交付、通过的 Gate、失败/无法验证、原 staged index 是否完全保持一致、证据文件路径、下一批最小建议。**Wave 1 完成后必须停止，把所有内容交给 ChatGPT 做独立审核。**
import type { JsonValue, SnapshotIssueCode } from './types.js';

/** Parsing/normalization errors, never a business Tool error. */
export class SnapshotDataError extends Error {
    constructor(
        readonly code: SnapshotIssueCode,
        readonly path: string,
        message: string,
    ) {
        super(message);
        this.name = 'SnapshotDataError';
    }
}

export interface JsonCopyLimits {
    readonly maxDepth: number;
    readonly maxNodes: number;
    readonly maxApproxBytes?: number;
}

/**
 * Copy instead of freezing developer-owned objects. Strict JSON data only:
 * no getters, symbols, class instances, sparse arrays, cycles or non-finite numbers.
 * A shared subobject is valid (copied twice); only ancestor cycles are rejected.
 * Security note: an untrusted Proxy may execute traps before it is rejected.
 * This is a data contract, not a hostile-JavaScript isolation boundary.
 */
export function copyJson(input: unknown, limits: JsonCopyLimits): JsonValue {
    const ancestors = new Set<object>();
    let nodes = 0;
    let approxBytes = 0;
    const byteLimit = limits.maxApproxBytes ?? Number.MAX_SAFE_INTEGER;
    function reserve(bytes: number, path: string): void {
        approxBytes += bytes;
        if (approxBytes > byteLimit) {
            throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Approximate input byte budget exceeded');
        }
    }
    function copy(value: unknown, path: string, depth: number): JsonValue {
        reserve(2, path); // minimum structural overhead; final canonical bytes are checked separately
        if (++nodes > limits.maxNodes) {
            throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Node budget exceeded');
        }
        if (depth > limits.maxDepth) {
            throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Depth budget exceeded');
        }
        if (typeof value === 'string') {
            if (value.length > byteLimit) {
                throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'String exceeds input byte budget');
            }
            reserve(utf8Size(value), path);
            return value;
        }
        if (value === null || typeof value === 'boolean') return value;
        if (typeof value === 'number' && Number.isFinite(value)) {
            reserve(24, path);
            return Object.is(value, -0) ? 0 : value;
        }
        if (typeof value !== 'object') {
            throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Expected finite JSON data');
        }
        if (ancestors.has(value)) {
            throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Cyclic object reference');
        }
        const array = Array.isArray(value);
        const prototype = Object.getPrototypeOf(value);
        if (array ? prototype !== Array.prototype : prototype !== Object.prototype && prototype !== null) {
            throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Expected plain JSON object/array');
        }
        ancestors.add(value);
        try {
            const descriptors = Object.getOwnPropertyDescriptors(value);
            const keys = Reflect.ownKeys(descriptors);
            if (keys.some(key => typeof key !== 'string')) {
                throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Symbol properties are forbidden');
            }
            if (array) {
                const length = (value as unknown[]).length;
                if (keys.length !== length + 1) {
                    throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path, 'Sparse array or extra properties');
                }
                const result: JsonValue[] = [];
                for (let i = 0; i < length; i++) {
                    const descriptor = descriptors[String(i)];
                    if (!descriptor || !descriptor.enumerable || !('value' in descriptor)) {
                        throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', path + '[' + i + ']', 'Invalid array element');
                    }
                    result.push(copy(descriptor.value, path + '[' + i + ']', depth + 1));
                }
                return Object.freeze(result);
            }
            const result: Record<string, JsonValue> = Object.create(null) as Record<string, JsonValue>;
            for (const key of keys as string[]) {
                const descriptor = descriptors[key]!;
                const fieldPath = path + '[' + JSON.stringify(key) + ']';
                if (key.length > byteLimit) {
                    throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', fieldPath, 'Object key exceeds byte budget');
                }
                reserve(utf8Size(key) + 4, fieldPath);
                if (!descriptor.enumerable || !('value' in descriptor)) {
                    throw new SnapshotDataError('SNAPSHOT_SERIALIZATION_ERROR', fieldPath, 'Accessors/hidden properties are forbidden');
                }
                Object.defineProperty(result, key, {
                    enumerable: true,
                    configurable: false,
                    writable: false,
                    value: copy(descriptor.value, fieldPath, depth + 1),
                });
            }
            return Object.freeze(result);
        } finally {
            ancestors.delete(value);
        }
    }
    return copy(input, '$', 0);
}

/** Lossless canonical encoding of *strict* JSON data (object field order normalized). */
export function canonicalJson(value: JsonValue): string {
    if (value === null || typeof value !== 'object') return JSON.stringify(value);
    if (Array.isArray(value)) return '[' + value.map(canonicalJson).join(',') + ']';
    const record = value as Readonly<Record<string, JsonValue>>;
    return '{' + Object.keys(record).sort().map(
        key => JSON.stringify(key) + ':' + canonicalJson(record[key]!),
    ).join(',') + '}';
}

export function utf8Size(value: string): number {
    return new TextEncoder().encode(value).byteLength;
}

/** For diagnostics only. Equality and authorization compare canonical data, not this hash. */
export function diagnosticDigest(canonical: string): string {
    const bytes = new TextEncoder().encode(canonical);
    let value = 0xcbf29ce484222325n;
    for (const byte of bytes) {
        value = BigInt.asUintN(64, (value ^ BigInt(byte)) * 0x100000001b3n);
    }
    return 'fnv1a64:' + value.toString(16).padStart(16, '0');
}
import fs from 'node:fs/promises';
import { constants } from 'node:fs';
import path from 'node:path';
import { createHash, randomUUID } from 'node:crypto';

const MAX_BYTES = 4 * 1024 * 1024;
const versionOf = (data: Buffer) => 'sha256:' + createHash('sha256').update(data).digest('hex');

async function inWorkspace(root: string, file: string): Promise<string> {
    const base = await fs.realpath(root);
    const absolute = path.resolve(root, file);
    const parent = await fs.realpath(path.dirname(absolute));
    if (parent !== base && !parent.startsWith(base + path.sep)) {
        throw new Error('RESOURCE_SCOPE_DENIED: file is outside the workspace');
    }
    return path.join(parent, path.basename(absolute));
}

async function readRegularFile(file: string) {
    // O_NOFOLLOW checks the final component at open time, not only during lstat.
    const handle = await fs.open(file, constants.O_RDONLY | constants.O_NOFOLLOW);
    try {
        const stat = await handle.stat();
        if (!stat.isFile() || stat.nlink !== 1 || stat.size > MAX_BYTES) {
            throw new Error('RESOURCE_UNSUPPORTED: expected an ordinary, non-hardlinked text file <= 4 MiB');
        }
        const bytes = await handle.readFile();
        if (bytes.length > MAX_BYTES) throw new Error('RESOURCE_TOO_LARGE: file exceeds 4 MiB');
        const after = await handle.stat();
        if (stat.dev !== after.dev || stat.ino !== after.ino ||
            stat.size !== after.size || stat.mtimeMs !== after.mtimeMs ||
            stat.ctimeMs !== after.ctimeMs || stat.nlink !== after.nlink) {
            throw new Error('RESOURCE_CHANGED_DURING_READ: file changed during version capture');
        }
        const content = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
        return { content, version: versionOf(bytes), stat };
    } finally {
        await handle.close();
    }
}

/**
 * A version is a content checksum, not an authorization token or a file lock.
 * Both operations require the caller to name an existing trusted workspace.
 */
export async function readVersionedFile(workspaceRoot: string, filePath: string) {
    return readRegularFile(await inWorkspace(workspaceRoot, filePath));
}

/**
 * Versioned replacement for COOPERATING writers. A sibling O_EXCL lock
 * serializes users of this API; old content is checked under that lock, then
 * staged and atomically renamed into place.
 *
 * Uncooperative writers do NOT honor the lock and may race between the final
 * comparison and rename. Do not advertise this as an OS-wide atomic CAS.
 */
export async function replaceFileIfVersion(
    workspaceRoot: string,
    filePath: string,
    expectedVersion: string,
    nextContent: string,
): Promise<
    | { status: 'written'; version: string; cleanupWarning?: string }
    | { status: 'conflict'; currentVersion: string }
> {
    if (!/^sha256:[0-9a-f]{64}$/.test(expectedVersion)) {
        throw new Error('RESOURCE_VERSION_INVALID: expected SHA-256 content version');
    }
    const data = Buffer.from(nextContent, 'utf8');
    if (data.length > MAX_BYTES) throw new Error('RESOURCE_TOO_LARGE: new file exceeds 4 MiB');
    const file = await inWorkspace(workspaceRoot, filePath);
    const lockPath = file + '.aotui-lock';
    let lock: Awaited<ReturnType<typeof fs.open>>;
    try {
        lock = await fs.open(lockPath, 'wx', 0o600);
    } catch (error) {
        if ((error as NodeJS.ErrnoException).code === 'EEXIST') {
            throw new Error('RESOURCE_BUSY: another versioned file operation is in progress');
        }
        throw error;
    }
    let temporary: string | undefined;
    let lockOwner: { ino: number; dev: number } | undefined;
    let written: { status: 'written'; version: string; cleanupWarning?: string } | undefined;
    try {
        lockOwner = await lock.stat();
        const before = await readRegularFile(file);
        if (before.version !== expectedVersion) {
            return { status: 'conflict', currentVersion: before.version };
        }

        temporary = path.join(path.dirname(file), '.' + path.basename(file) + '.aotui-' + randomUUID());
        const staged = await fs.open(temporary, 'wx', before.stat.mode & 0o777);
        try {
            await staged.writeFile(data);
            await staged.sync();
        } finally {
            await staged.close();
        }

        // Check again for best-effort detection of an uncooperative editor,
        // a swapped parent symlink, or a replacement lock inode.
        const lockedFile = await inWorkspace(workspaceRoot, filePath);
        if (lockedFile !== file) {
            throw new Error('RESOURCE_SCOPE_CHANGED: workspace path changed during mutation');
        }
        const lockNow = await fs.lstat(lockPath);
        if (!lockNow.isFile() || lockNow.dev !== lockOwner!.dev ||
            lockNow.ino !== lockOwner!.ino) {
            throw new Error('RESOURCE_LOCK_CHANGED: exclusive lock was replaced');
        }
        const now = await readRegularFile(file);
        if (now.version !== expectedVersion ||
            now.stat.dev !== before.stat.dev || now.stat.ino !== before.stat.ino) {
            return { status: 'conflict', currentVersion: now.version };
        }
        await fs.rename(temporary, file);
        temporary = undefined;
        written = { status: 'written', version: versionOf(data) };
        return written;
    } finally {
        const cleanupProblems: string[] = [];
        try {
            if (temporary) await fs.rm(temporary, { force: true });
        } catch {
            cleanupProblems.push('Temporary file cleanup failed');
        }
        try {
            const current = await fs.lstat(lockPath).catch(error => {
                if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined;
                throw error;
            });
            // Never knowingly delete another actor's replacement lock.
            if (current && lockOwner && current.dev === lockOwner.dev &&
                current.ino === lockOwner.ino) {
                await fs.unlink(lockPath);
            } else {
                cleanupProblems.push('Exclusive lock owner changed or disappeared');
            }
        } catch {
            cleanupProblems.push('Exclusive lock cleanup failed');
        }
        try { await lock.close(); } catch {
            cleanupProblems.push('Exclusive lock handle close failed');
        }
        if (cleanupProblems.length) {
            if (written) {
                // The rename HAS committed. Cleanup must not turn a completed
                // disk write into a false business failure or prompt a retry.
                written.cleanupWarning = cleanupProblems.join('; ');
            } else {
                throw new Error('RESOURCE_CLEANUP_FAILED: ' + cleanupProblems.join('; '));
            }
        }
    }
}

