{
  "name": "@aotui/system-chat",
  "version": "0.1.1",
  "description": "AOTUI System Chat Application - Agent-Human conversation interface",
  "type": "module",
  "main": "dist/electron/main.mjs",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && ELECTRON_BUILD_TARGET=main vite build -c vite.electron.config.ts && ELECTRON_BUILD_TARGET=preload vite build -c vite.electron.config.ts",
    "dev": "vite",
    "build:all": "npm run build && npm run build:gui",
    "build:gui": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "bash scripts/patch-electron-trpc.sh",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && npm run build:gui && bash scripts/patch-electron-trpc.sh && electron-builder",
    "rebuild": "electron-builder install-app-deps",
    "test:driver-types": "tsc -p tsconfig.srt06-driver-types.json"
  },
  "build": {
    "appId": "com.aotui.system-chat",
    "productName": "Agentina",
    "files": [
      "dist/**/*",
      "dist-gui/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/worker-runtime/**/*"
    ],
    "mac": {
      "icon": "build/icons/mac/icon.icns"
    },
    "dmg": {
      "artifactName": "${productName}.dmg"
    },
    "win": {
      "icon": "build/icons/win/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.39",
    "@ai-sdk/google": "^3.0.22",
    "@ai-sdk/openai": "^3.0.14",
    "@ai-sdk/react": "^3.0.47",
    "@ai-sdk/xai": "^3.0.48",
    "@aotui/agent-driver-v2": "^0.3.0",
    "@aotui/runtime": "7.0.0-srt.1",
    "@aotui/sdk": "0.8.0-srt.1",
    "@google/generative-ai": "^0.24.1",
    "@heroui/react": "^2.7.5",
    "@heroui/styles": "3.0.0-beta.5",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@trpc/client": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "@types/sql.js": "^1.4.9",
    "adm-zip": "^0.6.1",
    "ai": "6.0.326",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "electron-trpc": "0.4.5",
    "express": "^4.22.3",
    "framer-motion": "^12.29.0",
    "marked": "^17.0.1",
    "open": "^11.0.0",
    "openai": "^6.15.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.14.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.6.7",
    "@aotui/agent-driver-adapter": "0.4.0-srt.1",
    "@ai-sdk/provider-utils": "4.0.65"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "fast-check": "^4.5.3",
    "happy-dom": "^21.0.4",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1",
    "ws": "^8.22.2",
    "@types/json-schema": "7.0.15"
  },
  "overrides": {
    "@hono/node-server": "^1.19.12",
    "@xmldom/xmldom": "^0.8.15",
    "brace-expansion@1": "^1.1.20",
    "brace-expansion@2": "^2.1.2",
    "express-rate-limit": "^8.3.2",
    "flatted": "^3.4.2",
    "form-data@2.3.3": "2.5.4",
    "hono": "^4.12.25",
    "lodash": "^4.18.0",
    "lodash-es": "^4.18.1",
    "picomatch@4.0.3": "4.0.4",
    "path-to-regexp@0.1.12": "0.1.13",
    "path-to-regexp@8.3.0": "8.4.2",
    "rollup": "^4.60.1",
    "tar": "^7.5.21"
  },
  "pnpm": {
    "overrides": {
      "@aotui/agent-driver-v2": "link:../agent-driver-v2",
      "@aotui/runtime": "link:../runtime",
      "@aotui/sdk": "link:../sdk",
      "@hono/node-server": "^1.19.12",
      "@xmldom/xmldom": "^0.8.15",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.2",
      "express-rate-limit": "^8.3.2",
      "flatted": "^3.4.2",
      "form-data@2.3.3": "2.5.4",
      "hono": "^4.12.25",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.1",
      "picomatch@4.0.3": "4.0.4",
      "path-to-regexp@0.1.12": "0.1.13",
      "path-to-regexp@8.3.0": "8.4.2",
      "rollup": "^4.60.1",
      "tar": "^7.5.21",
      "@aotui/agent-driver-adapter": "link:../agent-driver-adapter",
      "ai@6": "6.0.326",
      "axios@1": "^1.20.0",
      "protobufjs@7": "^7.6.1"
    },
    "patchedDependencies": {
      "@ai-sdk/provider-utils@4.0.65": "../agent-driver-v2/patches/provider-utils-4.0.65.patch"
    }
  }
}
