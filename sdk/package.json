{
  "name": "@aotui/sdk",
  "version": "0.8.0-srt.1",
  "description": "Build Agent-Oriented TUI Apps with TypeScript or Preact",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node ./node_modules/@typescript/native/bin/tsc",
    "test": "vitest",
    "test:run": "vitest --run",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src",
    "prepublishOnly": "npm run build",
    "typecheck:static": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.static-tools.json"
  },
  "peerDependencies": {
    "typebox": "1.4.3",
    "preact": "^10.29.1"
  },
  "peerDependenciesMeta": {
    "preact": { "optional": true }
  },
  "dependencies": {
    "@aotui/runtime": "7.0.0-srt.1"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^27.0.1",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.4",
    "prettier": "^3.7.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typebox": "1.4.3",
    "vitest": "^3.2.4",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "brace-expansion@1.1.12": "1.1.13",
    "brace-expansion@2.0.2": "2.0.3",
    "flatted": "^3.4.2",
    "happy-dom": "^20.8.9",
    "minimatch@3.1.2": "3.1.4",
    "minimatch@9.0.5": "9.0.7",
    "picomatch@4.0.3": "4.0.4",
    "preact": "^10.29.1",
    "rollup": "^4.60.1"
  },
  "pnpm": {
    "overrides": {
      "@aotui/runtime": "link:../runtime",
      "ajv": "^6.14.0",
      "brace-expansion@1.1.12": "1.1.13",
      "brace-expansion@2.0.2": "2.0.3",
      "flatted": "^3.4.2",
      "happy-dom": "^20.8.9",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.7",
      "picomatch@4.0.3": "4.0.4",
      "preact": "^10.29.1",
      "rollup": "^4.60.1"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "keywords": [
    "aotui",
    "tui",
    "preact",
    "agent",
    "llm"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
