{
  "name": "@aotui/core",
  "version": "0.1.0",
  "description": "Portable AOTUI projection, observation and invocation contracts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./producer": {
      "types": "./dist/producer.d.ts",
      "import": "./dist/producer.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./schema-contract-vectors.json": "./src/tool/schema-contract-vectors.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "npm run build 1>&2"
  },
  "files": ["dist", "examples/public-core.ts", "src/tool/schema-contract-vectors.json"],
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "dependencies": { "acorn": "8.19.0", "typebox": "1.4.3" },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "picomatch@4.0.3": "4.0.4",
      "rollup": "^4.60.1"
    }
  }
}
