{
  "name": "@aotui/runtime",
  "version": "8.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aotui-stdio": "dist/stdio.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./adapters/memory-state-storage": {
      "types": "./dist/adapters/storage/memory-state-storage.d.ts",
      "import": "./dist/adapters/storage/memory-state-storage.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node scripts/build-file-example.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build 1>&2"
  },
  "keywords": [
    "aotui",
    "tui",
    "agent",
    "llm",
    "runtime"
  ],
  "author": "AOTUI",
  "license": "Apache-2.0",
  "description": "AOTUI Runtime for trusted Worker-hosted apps, View snapshots, and Tool invocation",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "examples"
  ],
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.1.12",
    "better-sqlite3": "13.2.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^27.0.1",
    "preact": "10.29.1",
    "prettier": "^3.7.4",
    "typebox": "1.4.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@aotui/core": "0.1.0"
  },
  "peerDependencies": {
    "better-sqlite3": "13.2.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "overrides": {
    "ajv": "^6.14.0",
    "flatted": "^3.4.2",
    "minimatch@3.1.2": "3.1.4",
    "minimatch@9.0.5": "9.0.7",
    "picomatch@4.0.3": "4.0.4",
    "preact": "10.29.1",
    "rollup": "^4.60.1",
    "brace-expansion@1": "^1.1.20",
    "brace-expansion@2": "^2.1.2"
  },
  "pnpm": {
    "overrides": {
      "@aotui/core": "link:../core",
      "ajv": "^6.14.0",
      "flatted": "^3.4.2",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.7",
      "picomatch@4.0.3": "4.0.4",
      "preact": "10.29.1",
      "rollup": "^4.60.1",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.2"
    }
  }
}
